# Copy to backend/.env and adjust. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://agrisense:agrisense@localhost:5432/agrisense
MONGO_URL=mongodb://localhost:27017
MONGO_DB=agrisense

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional: Google OAuth 2.0 (redirect URI = $OAUTH_REDIRECT_BASE/api/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# Optional: OpenWeather One Call / daily forecast key. Without it the API uses Open-Meteo (no key needed).
OPENWEATHER_API_KEY=
WEATHER_CACHE_MINUTES=180

# Optional: any OpenAI-compatible chat endpoint for the RAG assistant. Without it answers are extractive.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
